# cp .env.covered_call.example .env.covered_call
# Strategy + risk tier: accounts.toml (default risk_tier = medium)

DERIBIT_ENV=mainnet
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

ORDER_LABEL_PREFIX=demo_covered_call
STATE_FILE=.state/investors/demo/covered_call.json

REFERENCE_CAPITAL_USDC=1000
TARGET_PORTFOLIO_APR=0.25
TOP_N=5

# Shared skeleton already enables these. Uncomment only to override.
# ENABLE_DYNAMIC_TARGET_DELTA=true
# DYNAMIC_TARGET_DELTA_VRP_REF=0.05
# DYNAMIC_TARGET_DELTA_STRENGTH=0.3
# ENABLE_DYNAMIC_MIN_NET_APR=true
# ELEVATED_DELTA_MAX_TIGHTEN=0.02
# COVERED_CALL_CSP_DTE_MIN=2
# COVERED_CALL_CSP_DTE_MAX=10
# After manage dry-run only (jack playbook). an/ma/pat stay settlement.
# COVERED_CALL_CSP_SELF_ASSIGN_ENABLED=true
# Active roll stays OFF unless you explicitly opt in after dry-run.
# COVERED_CALL_CSP_ACTIVE_ROLL_ENABLED=false
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_DTE=2
# COVERED_CALL_CSP_ACTIVE_ROLL_MAX_DTE=10
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_TV_RATIO=0.25
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_NET_USDC=5
