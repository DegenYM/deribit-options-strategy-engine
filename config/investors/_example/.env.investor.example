# Investor-level fee billing (optional). Loaded before sub-account env files.
# See docs/investor-fee-disclosure-zh-TW.md

# Optional: covered-call spot held off NAV_perf (deducted as BTC + ETH in reports). Default 0.
# Also the profit-sweep floor when the book is flat (do not sell agreed cover).
# COLLATERAL_SPOT_BTC=0
# COLLATERAL_SPOT_ETH=0

# Fee rates (defaults match disclosure: 10% performance, 1% p.a. management).
PERFORMANCE_FEE_RATE=0.10
MANAGEMENT_FEE_ANNUAL_RATE=0.01

# Optional starting high-water mark (NAV_perf). Omit to auto-bootstrap from transaction log on first snapshot.
# INITIAL_HWM_NAV_PERF=100000

# Transaction-log scan start (UTC). Default: 2026-01-01 when omitted.
# FEE_FLOW_START_DATE=2026-01-01

# Covered call only: after income-exit closes with profit, sell native premium to USDT.
# Default false. Requires bot restart after change.
# COVERED_CALL_PROFIT_SWEEP_ENABLED=false

# Covered call only: after ITM spot exit sold cover, park a GTC limit buy at
# breakeven × (1 − edge). Later cycles reconcile only — never market-buy.
# Default false. Requires bot restart after change.
# COVERED_CALL_AUTO_SPOT_RESTORE_ENABLED=false
# Optional edge vs breakeven (0.001 = limit price is 0.1% below breakeven).
# COVERED_CALL_AUTO_SPOT_RESTORE_MIN_EDGE_PCT=0.001

# Covered call only: after ITM cover is sold to USDC, sell a short-dated
# cash-secured put at/just below the assigned strike. ITM spot exit then
# sells BTC_USDC / ETH_USDC (not USDT). USDT-sold legacy groups can still
# use auto spot restore. Default false. Requires bot restart after change.
# COVERED_CALL_ITM_TO_CASH_SECURED_ENABLED=false
# COVERED_CALL_CSP_DTE_MIN=2
# COVERED_CALL_CSP_DTE_MAX=10
# COVERED_CALL_CSP_STRIKE_FLOOR_PCT=0.05
# COVERED_CALL_CSP_MIN_OPEN_INTEREST=6
# COVERED_CALL_CSP_MIN_BOOK_NOTIONAL_USDC=3000
# CSP takes the bid with IOC; COVERED_CALL_CSP_MAX_SPREAD_RATIO is unused.
# Where the CSP premium lands: usdc keeps it as stablecoin (default), spot swaps
# the net premium (not the reserved assignment cash) into native coin after entry.
# COVERED_CALL_CSP_PREMIUM_TARGET=usdc
