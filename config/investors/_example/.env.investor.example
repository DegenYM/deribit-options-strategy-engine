# Investor-level fee billing (optional). Loaded before sub-account env files.
# See docs/investor-fee-disclosure-zh-TW.md

# Optional: covered-call spot held off NAV_perf (deducted as BTC + ETH in reports). Default 0.
# Also the profit-sweep floor when the book is flat (do not sell agreed cover).
# COLLATERAL_SPOT_BTC=0
# COLLATERAL_SPOT_ETH=0

# Fee rates (defaults match disclosure: 10% performance, 1% p.a. management).
PERFORMANCE_FEE_RATE=0.10
MANAGEMENT_FEE_ANNUAL_RATE=0.01

# Optional starting high-water mark (NAV_perf). Omit to auto-bootstrap from transaction log on first snapshot.
# INITIAL_HWM_NAV_PERF=100000

# Transaction-log scan start (UTC). Default: 2026-01-01 when omitted.
# FEE_FLOW_START_DATE=2026-01-01

# Covered call only: after income-exit closes with profit, sell native premium to USDT.
# Default false. Requires bot restart after change.
# COVERED_CALL_PROFIT_SWEEP_ENABLED=false

# Covered call only: after ITM spot exit sold cover, park a GTC limit buy at
# breakeven × (1 − edge). Later cycles reconcile only — never market-buy.
# Default false. Requires bot restart after change.
# COVERED_CALL_AUTO_SPOT_RESTORE_ENABLED=false
# Optional edge vs breakeven (0.001 = limit price is 0.1% below breakeven).
# COVERED_CALL_AUTO_SPOT_RESTORE_MIN_EDGE_PCT=0.001

# Covered call only: after ITM cover is sold to USDC, sell a short-dated
# cash-secured put at/just below the assigned strike. ITM spot exit then
# sells BTC_USDC / ETH_USDC (not USDT). USDT-sold legacy groups can still
# use auto spot restore. Default false. Requires bot restart after change.
# COVERED_CALL_ITM_TO_CASH_SECURED_ENABLED=false
# CSP DTE window (engine default 2–10). Do not copy live eugene/youming/jack
# values here — leave unset to inherit the default.
# COVERED_CALL_CSP_DTE_MIN=2
# COVERED_CALL_CSP_DTE_MAX=10
# COVERED_CALL_CSP_STRIKE_FLOOR_PCT=0.05
# COVERED_CALL_CSP_MIN_OPEN_INTEREST=0.5
# COVERED_CALL_CSP_MIN_OPEN_INTEREST_ETH=5
# COVERED_CALL_CSP_MIN_BOOK_NOTIONAL_USDC=3000
# CSP takes the bid with IOC; COVERED_CALL_CSP_MAX_SPREAD_RATIO is unused.
# Where the CSP premium lands: usdc keeps it as stablecoin (default), spot swaps
# the realized premium into native coin after the put is closed/expired (not at
# entry; waits for ITM cover restore if that is pending).
# COVERED_CALL_CSP_PREMIUM_TARGET=usdc
# Self-assign when ITM is confirmed and either DTE ≤ max or time-value is thin
# vs intrinsic (buy put back + buy spot), and the put book is liquid enough to
# lift (spread + ask size). Short DTE books are often too wide — then wait for
# expiry. Default on when the wheel is enabled.
# COVERED_CALL_CSP_SELF_ASSIGN_ENABLED=true
# COVERED_CALL_CSP_SELF_ASSIGN_CONFIRM_CYCLES=3
# COVERED_CALL_CSP_SELF_ASSIGN_MAX_DTE=2
# COVERED_CALL_CSP_SELF_ASSIGN_MAX_TV_PCT=0.12
# COVERED_CALL_CSP_SELF_ASSIGN_MAX_SPREAD_RATIO=0.25
# Active roll: buy back an OTM CSP before expiry and sell a higher daily-yield
# put in the same strike/DTE window (same or earlier expiry is OK). Default OFF.
# Do not copy into live investor files unless you have reviewed manage dry-run
# would_place / reason codes.
# COVERED_CALL_CSP_ACTIVE_ROLL_ENABLED=false
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_DTE=2
# COVERED_CALL_CSP_ACTIVE_ROLL_MAX_DTE=10
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_TV_RATIO=0.25
# COVERED_CALL_CSP_ACTIVE_ROLL_MIN_NET_USDC=5
#
# Operator playbook (do NOT flip live money knobs blindly):
# - youming covered_call may set accounts.toml risk_tier = "low" after review
#   (aligns delta/APR to the conservative shared low profile; no live file change).
# - jack may set COVERED_CALL_CSP_SELF_ASSIGN_ENABLED=true after observing
#   manage dry-run on the wheel path.
# - an / ma / pat stay on settlement spot-exit (do not enable self-assign).
#
# Strategy dynamism (Wave 1–2). Prefer the shared covered_call skeleton;
# uncomment here only to override a single investor.
# ENABLE_DYNAMIC_TARGET_DELTA=true
# DYNAMIC_TARGET_DELTA_STRENGTH=0.3
# ENABLE_DYNAMIC_MIN_NET_APR=true
# ELEVATED_DELTA_MAX_TIGHTEN=0.02
# Naked defaults halt on elevated / OTM-only delta / tighten-only APR.
# NAKED_ALLOW_ELEVATED_ENTRY=true              # opt in: sell with 0.04 haircut
# NAKED_DYNAMIC_DELTA_ALLOW_CLOSER=true        # opt in: thin VRP may rank closer
# NAKED_DYNAMIC_MIN_NET_APR_ALLOW_LOOSEN=true  # opt in: low IVR may lower MIN_NET_APR

# ---------------------------------------------------------------------------
# Dashboard / admin console 存取控制（frontend_server.auth、admin_server 直接讀
# process env；BotConfig 也會鏡射這些欄位，並在 repr / to_safe_dict 中遮罩 token）。
# ---------------------------------------------------------------------------
# Dashboard /api/* 與 /ws/* 的共用 token（Bearer 或 X-Dashboard-Token）；空值 = 不啟用閘門。預設空。
# DASHBOARD_API_TOKEN=
# true 時把 token 以 <meta name="dashboard-api-token"> 嵌入 index/investor HTML（僅適合 Cloudflare Access 之後）。預設 false。
# DASHBOARD_API_TOKEN_EMBED=false
# 允許跨來源存取 dashboard API 的 Origin 逗號清單；空值 = 不掛 CORS middleware（不再預設 *）。預設空。
# DASHBOARD_CORS_ORIGINS=
# 本機 admin console 的共用 token（X-Admin-Token）；空值 = 只靠 loopback / client-IP 檢查。預設空。
# ADMIN_CONSOLE_TOKEN=
# true 時把 admin token 嵌入 admin.html。預設 false。
# ADMIN_CONSOLE_TOKEN_EMBED=false

# ---------------------------------------------------------------------------
# State 檔持久化與快取保留
# ---------------------------------------------------------------------------
# true 時 state JSON 以縮排格式寫入（預設 compact，檔案每個 cycle 都會重寫）。預設 false。
# STATE_JSON_PRETTY=false
# 選用：live manage cycle 存檔前把過舊的 closed groups 搬到 <stem>.closed_archive.jsonl。預設 false。
# STATE_CLOSED_ARCHIVE_ENABLED=false
# closed 超過幾天才可歸檔（0 = 不看天數）。預設 90。
# STATE_CLOSED_ARCHIVE_KEEP_DAYS=90
# 無論多舊，至少保留最新 N 筆 closed groups 在 state 檔內。預設 20。
# STATE_CLOSED_ARCHIVE_KEEP_MIN=20
# data/public_read_cache.db 中 public/* 快取列的最大存活秒數（最小 60）。預設 86400。
# PUBLIC_CACHE_MAX_AGE_SECONDS=86400
# data/public_read_cache.db 最多保留的快取列數，超過時淘汰最舊者（最小 100）。預設 5000。
# PUBLIC_CACHE_MAX_ROWS=5000
