# Risk tier: low (conservative covered call)
# Retain spot: delta hard gate + sort primary; OTM_MIN is a safety floor (no OTM max).

PUT_DTE_MIN=7
PUT_DTE_MAX=35
# Rally: only widen bid-ask gate (15% → 18%). Keep OTM/delta so LOW still retains spot.
INVERSE_MAX_SPREAD_RATIO=0.18

MAX_GROUPS_PER_CURRENCY=3

BTC_CALL_DELTA_MIN=0.05
BTC_CALL_DELTA_MAX=0.10
BTC_PREFERRED_CALL_DELTA_MIN=0.05
BTC_PREFERRED_CALL_DELTA_MAX=0.08
BTC_CALL_OTM_MIN=0.12

ETH_CALL_DELTA_MIN=0.05
ETH_CALL_DELTA_MAX=0.09
ETH_PREFERRED_CALL_DELTA_MIN=0.05
ETH_PREFERRED_CALL_DELTA_MAX=0.08
ETH_CALL_OTM_MIN=0.14

# APR: low tier targets 4–6% (sort soft only; delta/OTM rank first).
MIN_NET_APR=0.035
TARGET_NET_APR_MIN=0.04
TARGET_NET_APR_MAX=0.06
BOOK_IM_TARGET=0.40
BOOK_IM_HARD=0.48
BOOK_MM_TARGET=0.4
BOOK_MM_HARD=0.5

TP_CAPTURE_PCT=0.55
EARLY_EXIT_REMAINING_APR=0.06
EARLY_EXIT_MIN_PROFIT_CAPTURE=0.4
EARLY_EXIT_MAX_SPREAD_RATIO=0.06

TIME_EXIT_MIN_PROFIT_CAPTURE=0.1

ENABLE_DYNAMIC_TP=true
TP_CAPTURE_PCT_DTE_LONG=0.40
TP_CAPTURE_PCT_DTE_SHORT=0.60
TP_DTE_LONG_THRESHOLD=14
TP_DTE_SHORT_THRESHOLD=7

COVERED_CALL_SPOT_EXIT_ENABLED=true
COVERED_CALL_ROBUST_EXIT_ENABLED=false
COVERED_CALL_ITM_BUFFER_PCT=0
COVERED_CALL_SPOT_ORDER_TYPE=market
COVERED_CALL_SPOT_MAX_SLIPPAGE_PCT=0.001
