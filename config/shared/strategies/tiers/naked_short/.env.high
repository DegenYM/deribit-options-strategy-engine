# Risk tier: high (aggressive naked short put)
# Put-only: delta hard gate + sort primary; PUT_OTM_MIN is a safety floor (no OTM max).

PUT_DTE_MIN=10
PUT_DTE_MAX=35

BTC_PUT_DELTA_MIN=0.10
BTC_PUT_DELTA_MAX=0.18
BTC_PREFERRED_PUT_DELTA_MIN=0.11
BTC_PREFERRED_PUT_DELTA_MAX=0.15
BTC_PUT_OTM_MIN=0.05

ETH_PUT_DELTA_MIN=0.08
ETH_PUT_DELTA_MAX=0.16
ETH_PREFERRED_PUT_DELTA_MIN=0.09
ETH_PREFERRED_PUT_DELTA_MAX=0.13
ETH_PUT_OTM_MIN=0.06

# APR: high tier targets 8–14% (sort soft only; delta/OTM rank first).
MIN_NET_APR=0.07
TARGET_NET_APR_MIN=0.08
TARGET_NET_APR_MAX=0.14
PER_LEG_IM_CAP_PUT=0.18
EXPIRY_IM_CAP=0.55
BOOK_IM_TARGET=0.55
BOOK_IM_HARD=0.80
BOOK_MM_TARGET=0.4
BOOK_MM_HARD=0.6

TP_CAPTURE_PCT=0.5
EARLY_EXIT_REMAINING_APR=0.04
EARLY_EXIT_MIN_PROFIT_CAPTURE=0.4
EARLY_EXIT_MAX_SPREAD_RATIO=0.08
TIME_EXIT_MIN_PROFIT_CAPTURE=0.1
SOFT_DEFENSE_DELTA=0.35
HARD_DEFENSE_DELTA=0.45
SOFT_DEFENSE_LOSS_PCT=0.5
HARD_STOP_LOSS_PCT=0.6

ENABLE_DYNAMIC_TP=true
TP_CAPTURE_PCT_DTE_LONG=0.40
TP_CAPTURE_PCT_DTE_SHORT=0.60
TP_DTE_LONG_THRESHOLD=14
TP_DTE_SHORT_THRESHOLD=7
