# Risk tier: low (conservative naked short put)
# Put-only: delta hard gate + sort primary; PUT_OTM_MIN is a safety floor (no OTM max).

PUT_DTE_MIN=10
PUT_DTE_MAX=35

MAX_GROUPS_PER_CURRENCY=2

BTC_PUT_DELTA_MIN=0.06
BTC_PUT_DELTA_MAX=0.11
BTC_PREFERRED_PUT_DELTA_MIN=0.07
BTC_PREFERRED_PUT_DELTA_MAX=0.09
BTC_PUT_OTM_MIN=0.10

ETH_PUT_DELTA_MIN=0.05
ETH_PUT_DELTA_MAX=0.10
ETH_PREFERRED_PUT_DELTA_MIN=0.06
ETH_PREFERRED_PUT_DELTA_MAX=0.08
ETH_PUT_OTM_MIN=0.12

# APR: low tier targets 4.5–8% (sort soft only; delta/OTM rank first).
MIN_NET_APR=0.035
TARGET_NET_APR_MIN=0.045
TARGET_NET_APR_MAX=0.08
PER_LEG_IM_CAP_PUT=0.10
EXPIRY_IM_CAP=0.35
BOOK_IM_TARGET=0.45
BOOK_IM_HARD=0.65
BOOK_MM_TARGET=0.35
BOOK_MM_HARD=0.5

TP_CAPTURE_PCT=0.5
EARLY_EXIT_REMAINING_APR=0.04
EARLY_EXIT_MIN_PROFIT_CAPTURE=0.4
EARLY_EXIT_MAX_SPREAD_RATIO=0.08
TIME_EXIT_MIN_PROFIT_CAPTURE=0.1
SOFT_DEFENSE_DELTA=0.20
HARD_DEFENSE_DELTA=0.28
SOFT_DEFENSE_LOSS_PCT=0.35
HARD_STOP_LOSS_PCT=0.5

ENABLE_DYNAMIC_TP=true
TP_CAPTURE_PCT_DTE_LONG=0.40
TP_CAPTURE_PCT_DTE_SHORT=0.60
TP_DTE_LONG_THRESHOLD=14
TP_DTE_SHORT_THRESHOLD=7
