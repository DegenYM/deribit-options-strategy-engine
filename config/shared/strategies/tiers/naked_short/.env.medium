# Risk tier: medium (naked short put)
# Put-only: delta hard gate + sort primary; PUT_OTM_MIN is a safety floor (no OTM max).
# YM live uses this unhedged medium profile (no perp hedge; Jack stays hedge-first
# via investor env and is not live).

# Reach the monthly expiry. Deribit's open interest sits in the monthlies; the
# weeklies this window used to hold (14d, 21d) carry an OI of 0-2 against a floor
# of 8, so every cycle from 2026-09-11 scanned an empty window, failed the core
# liquidity check and was forced to regime=crisis. The October monthly at 42 DTE
# has OI 118-563 with 2-4% spreads.
PUT_DTE_MIN=14
PUT_DTE_MAX=45

# One slot per currency left the scan idle: on 2026-09-18 ETH had five strikes
# through every gate and the only blocker was max_groups_per_currency. Two slots
# per currency, three in total, so a second ETH strike can open while BTC waits
# out its IV gate. MAX_GROUPS_PER_BOOK is unset and inherits the per-currency
# value. The IM caps below are the real size limit, not this count.
MAX_GROUPS_PER_CURRENCY=2
MAX_CONCURRENT_GROUPS=3

# Delta ceilings rise with the window: at 42 DTE the same distance out carries
# roughly twice the delta it does at 14, so the old caps rejected the monthly
# strikes on delta the moment the DTE gate let them through (ETH 2000-P sits
# 19.4% out and still reads 0.101). The extra room past that is the bullish
# tilt -- nearer strikes, more premium, more assignment risk if the call is wrong.
# The hard max is only a ceiling: naked_put_sort_key tiers candidates by whether
# they sit in the PREFERRED band before anything else, so raising the ceiling
# alone would make richer strikes eligible and never pick them. Both move, a
# notch at a time -- BTC targets 0.14 instead of 0.115, ETH 0.125 instead of
# 0.10. On the 2026-09-18 book that is ETH 2150-P (bid 32.4) instead of 2100-P
# (26.2): ~24% more premium, delta 0.109 -> 0.131.
BTC_PUT_DELTA_MIN=0.07
BTC_PUT_DELTA_MAX=0.24
BTC_PREFERRED_PUT_DELTA_MIN=0.10
BTC_PREFERRED_PUT_DELTA_MAX=0.18
BTC_PUT_OTM_MIN=0.08

ETH_PUT_DELTA_MIN=0.06
ETH_PUT_DELTA_MAX=0.20
ETH_PREFERRED_PUT_DELTA_MIN=0.09
ETH_PREFERRED_PUT_DELTA_MAX=0.16
ETH_PUT_OTM_MIN=0.10

# Bullish tilt: an elevated regime is usually a vol print, and upside vol is not
# a reason to stop selling puts. Entry still tightens by
# NAKED_ELEVATED_DELTA_MAX_TIGHTEN; crisis still stops everything, and the
# down-streak / below-MA20 brakes in the skeleton are untouched.
NAKED_ALLOW_ELEVATED_ENTRY=true

# APR: medium tier targets 6–11% (sort soft only; delta/OTM rank first).
MIN_NET_APR=0.05
TARGET_NET_APR_MIN=0.06
TARGET_NET_APR_MAX=0.11
PER_LEG_IM_CAP_PUT=0.10
EXPIRY_IM_CAP=0.20
BOOK_IM_TARGET=0.22
BOOK_IM_HARD=0.40
# MM tracks the tighter IM book (was 0.40 / 0.60 at IM 0.50 / 0.75).
BOOK_MM_TARGET=0.18
BOOK_MM_HARD=0.32
OPEN_MAX_LOSS_HALT_RATIO=0.40

SOFT_DEFENSE_DELTA=0.20
HARD_DEFENSE_DELTA=0.28
SOFT_DEFENSE_LOSS_PCT=0.22
HARD_STOP_LOSS_PCT=0.32

# Open interest floor. The shared profile's 8 rejects 48 of the 53 BTC strikes in
# the window and leaves two candidates; 3 leaves six, which is what the delta
# band above needs to have something to choose from. Spread is not the binding
# gate here (it rejects one strike), so LINEAR_MAX_SPREAD_RATIO stays at 0.10 --
# that is the one that decides what an exit costs.
LINEAR_MIN_OPEN_INTEREST=3

# Take profit later. The linear USDC book lists 1/2/3/4/7/14/42-day expiries and
# nothing between 14 and 42, so capital freed early has nowhere to go: cycling
# faster buys an idle balance, not another trade. Ladder stays monotonic as
# expiry approaches (>=14d 0.65, 7-14d 0.70, <=7d 0.75).
TP_CAPTURE_PCT=0.70
TP_CAPTURE_PCT_DTE_LONG=0.65
TP_CAPTURE_PCT_DTE_SHORT=0.75

# Early exit released a position once remaining APR fell under 4% with 40%
# captured. With one tradeable expiry that is the same idle-capital trade, and it
# capped the winners well below the new take-profit ladder.
ENABLE_EARLY_EXIT=false
