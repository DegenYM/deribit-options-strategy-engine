# Risk tier: medium (naked short put)
# Put-only: delta hard gate + sort primary; PUT_OTM_MIN is a safety floor (no OTM max).
# YM live uses this unhedged medium profile (no perp hedge; Jack stays hedge-first
# via investor env and is not live).

# Reach the monthly expiry. Deribit's open interest sits in the monthlies; the
# weeklies this window used to hold (14d, 21d) carry an OI of 0-2 against a floor
# of 8, so every cycle from 2026-09-11 scanned an empty window, failed the core
# liquidity check and was forced to regime=crisis. The October monthly at 42 DTE
# has OI 118-563 with 2-4% spreads.
PUT_DTE_MIN=14
PUT_DTE_MAX=45

MAX_GROUPS_PER_CURRENCY=1
MAX_CONCURRENT_GROUPS=2

# Delta ceilings rise with the window: at 42 DTE the same distance out carries
# roughly twice the delta it does at 14, so the old caps rejected the monthly
# strikes on delta the moment the DTE gate let them through (ETH 2000-P sits
# 19.4% out and still reads 0.101). The extra room past that is the bullish
# tilt -- nearer strikes, more premium, more assignment risk if the call is wrong.
BTC_PUT_DELTA_MIN=0.07
BTC_PUT_DELTA_MAX=0.20
BTC_PREFERRED_PUT_DELTA_MIN=0.08
BTC_PREFERRED_PUT_DELTA_MAX=0.15
BTC_PUT_OTM_MIN=0.08

ETH_PUT_DELTA_MIN=0.06
ETH_PUT_DELTA_MAX=0.16
ETH_PREFERRED_PUT_DELTA_MIN=0.07
ETH_PREFERRED_PUT_DELTA_MAX=0.13
ETH_PUT_OTM_MIN=0.10

# Bullish tilt: an elevated regime is usually a vol print, and upside vol is not
# a reason to stop selling puts. Entry still tightens by
# NAKED_ELEVATED_DELTA_MAX_TIGHTEN; crisis still stops everything, and the
# down-streak / below-MA20 brakes in the skeleton are untouched.
NAKED_ALLOW_ELEVATED_ENTRY=true

# APR: medium tier targets 6–11% (sort soft only; delta/OTM rank first).
MIN_NET_APR=0.05
TARGET_NET_APR_MIN=0.06
TARGET_NET_APR_MAX=0.11
PER_LEG_IM_CAP_PUT=0.10
EXPIRY_IM_CAP=0.20
BOOK_IM_TARGET=0.22
BOOK_IM_HARD=0.40
# MM tracks the tighter IM book (was 0.40 / 0.60 at IM 0.50 / 0.75).
BOOK_MM_TARGET=0.18
BOOK_MM_HARD=0.32
OPEN_MAX_LOSS_HALT_RATIO=0.40

SOFT_DEFENSE_DELTA=0.20
HARD_DEFENSE_DELTA=0.28
SOFT_DEFENSE_LOSS_PCT=0.22
HARD_STOP_LOSS_PCT=0.32
