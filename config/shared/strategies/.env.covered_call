# Strategy skeleton: OPTION_STRATEGY=covered_call
# Risk tiers: config/shared/strategies/tiers/covered_call/.env.{low,medium,high}
# Shared pacing & liquidity defaults: config/shared/.env.defaults

OPTION_STRATEGY=covered_call
OPTION_MARKETS_PROFILE=inverse_native
TRADED_COLLATERALS=BTC,ETH
SHORT_OPTION_SIDE=call

# Vol gate: looser than shared defaults — CC quality is delta + MIN_NET_APR.
# Keep a light IVR floor so dead-flat vol still skips; disable IV−RV filter.
ENABLE_IV_ENTRY_GATE=true
MIN_IV_RANK=0.05
BTC_MIN_IV_RANK=0.05
ETH_MIN_IV_RANK=0.05
MIN_IV_MINUS_RV=0

# Fast upside: pause new entries as elevated (does not hard-derisk open groups).
ENABLE_INDEX_RALLY_ENTRY_HALT=true
INDEX_RALLY_24H_PCT=0.05
INDEX_RALLY_48H_PCT=0.07
