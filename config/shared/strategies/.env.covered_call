# Strategy skeleton: OPTION_STRATEGY=covered_call
# Risk tiers: config/shared/strategies/tiers/covered_call/.env.{low,medium,high}
# Shared pacing & liquidity defaults: config/shared/.env.defaults

OPTION_STRATEGY=covered_call
OPTION_MARKETS_PROFILE=inverse_native
TRADED_COLLATERALS=BTC,ETH
SHORT_OPTION_SIDE=call

# Vol gate: looser than shared defaults — CC quality is delta + MIN_NET_APR.
# Keep a light IVR floor so dead-flat vol still skips; disable IV−RV filter.
ENABLE_IV_ENTRY_GATE=true
MIN_IV_RANK=0.05
BTC_MIN_IV_RANK=0.05
ETH_MIN_IV_RANK=0.05
MIN_IV_MINUS_RV=0

# Wave 1: shift preferred-delta ranking target with VRP (never hard DELTA_MIN/MAX).
# Conservative strength 0.3 (engine default is 0.5).
ENABLE_DYNAMIC_TARGET_DELTA=true
DYNAMIC_TARGET_DELTA_VRP_REF=0.05
DYNAMIC_TARGET_DELTA_STRENGTH=0.3

# Wave 2: elevated allows entry with a tighter |delta| max (crisis still halts).
ELEVATED_DELTA_MAX_TIGHTEN=0.02
# ELEVATED_MAX_GROUPS_TIGHTEN=0

# Wave 2: slightly loosen/tighten MIN_NET_APR from IVR (fallback IV−RV). ±0.5pp max.
ENABLE_DYNAMIC_MIN_NET_APR=true
# DYNAMIC_MIN_NET_APR_MAX_SHIFT=0.005
# DYNAMIC_MIN_NET_APR_FLOOR=   # empty → MIN_NET_APR * 0.7
# DYNAMIC_MIN_NET_APR_IVR_REF=0.50

# --- Trend-adaptive selection (ported from Canopy, 2026-09-14) ----------------
# A covered call is written on coin you want to keep, so direction is not a symmetric
# risk: a rising market calls the coin away; a falling one makes a nearer strike both
# richer and safer.
#
# Signal = (spot − 20-day MA) / 20-day MA / TREND_REF_PCT, clamped to ±1. The average is
# taken over Deribit's settled daily closes (public/get_delivery_prices), not the 1y
# index chart — that chart is 6-hourly, which made a "20-day" average a 5-day one.
#   +1 rising  → target delta slides to the far edge of the preferred band, OTM floor lifts
#   −1 falling → target slides to the near edge; delta ceiling and OTM floor give a little
# Independent of ENABLE_TREND_SIDE_BIAS (put-vs-call side selection).
ENABLE_TREND_ADAPTIVE_SELECTION=true
TREND_MA_DAYS=20
TREND_REF_PCT=0.05
# Full signal pushes the target to the band edge; summed with the VRP term, clamped once.
TREND_TARGET_DELTA_STRENGTH=1.0
# Falling only: hard delta ceiling +0.03 (medium 0.13 → 0.16); preferred ceiling follows.
TREND_DELTA_MAX_STRETCH=0.03
# OTM floor moves in proportion, both ways: ±37.5% (medium 8% ranges 5.0%–11.0%).
TREND_OTM_FLOOR_RATIO=0.375
#
# Pause — the one response that earns nothing — requires both:
#   1. spot more than 5% above the 20-day MA (a steady climb of g/day sits ~9.5g above
#      it, so ≈ 0.53%/day ≈ 17%/month). 0 disables the pause.
#   2. the 20-day MA still above the 100-day MA (structure, not just speed).
# On 2299 days of BTC settlements (2020-05 → 2026-08) the days it fires were called away
# 29.8% of the time against a 22.9% base (1.30×); the regime gate alone is 1.05×.
TREND_PAUSE_ABOVE_PCT=0.05
TREND_PAUSE_REQUIRES_BULL_REGIME=true
TREND_REGIME_MA_DAYS=100

# --- ITM exit and the wheel: one definition for every tier and account (2026-09-14) ----
# Everything that happens after a covered call settles in the money is set here, once:
#   1. sell the called-away coin         2. sell a cash-secured put to buy it back
#   3. banked put premium lifts the next strike   4. that premium stays in USDC
# The spot exit used to sit in each tier file (identical in all three) while the wheel
# switch sat here. Every covered_call account that does not set a key itself gets this.
# Opt out in the sub-account env (accounts/.env.covered_call), which is applied after this
# file; .env.investor is applied before it and cannot override anything here.

# 1. ITM -> sell the cover. After expiry settles in the money, the next manage cycle sells
#    cover − settlement loss. With the wheel on it sells into USDC, the put's collateral;
#    an account that turns the wheel off sells into USDT.
COVERED_CALL_SPOT_EXIT_ENABLED=true
COVERED_CALL_ROBUST_EXIT_ENABLED=false
COVERED_CALL_ITM_BUFFER_PCT=0
COVERED_CALL_SPOT_ORDER_TYPE=market
COVERED_CALL_SPOT_MAX_SLIPPAGE_PCT=0.001

# 2. CSP buy-back (on since 2026-09-14): a short-dated USDC put, strike in
#    [K × (1 − COVERED_CALL_CSP_STRIKE_FLOOR_PCT), K] with K the called-away strike.
#    Switched on only after expiry decisions moved to the delivery price, self-assign was
#    fenced (below), and skipped puts started being reported in live runs.
COVERED_CALL_ITM_TO_CASH_SECURED_ENABLED=true

# Self-assign follows the wheel. It deliberately trades an ITM put's remaining time value
# for a certain coin buy-back, so the cost has to be fenced. Engine defaults — within 2
# days, spread up to 25%, one 15-second confirmation — let a single wick trigger it.
# Measured once in Canopy's simulator: paid 2,210 USDC to buy back a put worth 1,480
# intrinsic; 730 of time value gone.
COVERED_CALL_CSP_SELF_ASSIGN_MAX_DTE=1
COVERED_CALL_CSP_SELF_ASSIGN_MAX_SPREAD_RATIO=0.10
COVERED_CALL_CSP_SELF_ASSIGN_CONFIRM_CYCLES=4

# 3. Premium ladder (ported from Canopy, 2026-09-14). K never moves on its own, so once
#    spot runs past it the window empties — on real chains at about 20% above K for BTC
#    and 30% for ETH. What caps a cash-secured strike is collateral, and collateral is the
#    sale proceeds plus what the puts earned, so the closed puts' net premium lifts the
#    ceiling to K + banked / contracts. Not free money: a strike nearer the money brings
#    the coin back more often, at a higher price. With the strike near spot it catches up
#    about 0.26%/day on BTC and 0.36%/day on ETH (≈ 5–8% and 8–12% of drift a month).
CSP_PREMIUM_LADDER=true

# 4. CSP premium stays in USDC, never swapped into coin. The ladder spends that premium,
#    so config refuses COVERED_CALL_CSP_PREMIUM_TARGET=spot while CSP_PREMIUM_LADDER=true:
#    an account that wants the swap has to turn the ladder off as well.
COVERED_CALL_CSP_PREMIUM_TARGET=usdc
