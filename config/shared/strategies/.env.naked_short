# Strategy skeleton: OPTION_STRATEGY=naked_short
# Risk tiers: config/shared/strategies/tiers/naked_short/.env.{low,medium,high}
# Shared pacing & liquidity defaults: config/shared/.env.defaults

OPTION_STRATEGY=naked_short
OPTION_MARKETS_PROFILE=linear_usdc
TRADED_COLLATERALS=USDC
SHORT_OPTION_SIDE=put

# Vol gate: looser than shared defaults — naked put quality is delta + MIN_NET_APR.
# Keep a light IVR floor so dead-flat vol still skips; disable IV−RV filter.
ENABLE_IV_ENTRY_GATE=true
MIN_IV_RANK=0.05
BTC_MIN_IV_RANK=0.05
ETH_MIN_IV_RANK=0.05
MIN_IV_MINUS_RV=0

# Put-only: trend/skew side selection has no competing call wing.
ENABLE_TREND_SIDE_BIAS=false
ENABLE_SKEW_SIDE_SELECTION=false

# Fast upside: mark elevated (does not hard-derisk open groups).
ENABLE_INDEX_RALLY_ENTRY_HALT=true
INDEX_RALLY_24H_PCT=0.05
INDEX_RALLY_48H_PCT=0.07

# Wick filter: require two manage cycles before soft/hard defense.
DEFENSE_CONFIRM_CYCLES=2
DEFENSE_TRIGGER_USE_MARK=true

# Unhedged book: one group per coin, two coins max. Do NOT set ENABLE_PERP_HEDGE
# here — Jack's .env.investor is hedge-first and loads before this file.
MAX_GROUPS_PER_CURRENCY=1
MAX_CONCURRENT_GROUPS=2
ENABLE_NAKED_TOPUP=false

# Linear USDC liquidity (OI ≥ 8, notional ≥ 4000, spread ≤ 10%).
LINEAR_MIN_OPEN_INTEREST=8
LINEAR_MIN_BOOK_NOTIONAL_USDC=4000
LINEAR_MAX_SPREAD_RATIO=0.10

# Spot ≥2% below MA20 → skip that coin. Any mark-losing group → no second coin.
NAKED_ENTRY_BELOW_MA_PCT=0.02
NAKED_BLOCK_SECOND_CCY_ON_MARK_LOSS=true

# Wave 1: VRP ranking-target tilt, but OTM-only. Rich vol ranks further-OTM
# puts higher; thin vol does NOT pull toward ATM (unlike covered_call).
# Does not move hard PUT/CALL_DELTA_MIN/MAX.
ENABLE_DYNAMIC_TARGET_DELTA=true
DYNAMIC_TARGET_DELTA_VRP_REF=0.05
DYNAMIC_TARGET_DELTA_STRENGTH=0.3
NAKED_DYNAMIC_DELTA_ALLOW_CLOSER=false

# Wave 2: unhedged short put — elevated / down-streak HALTS new entries.
# Crisis still full-halts. Opt in only after review:
# NAKED_ALLOW_ELEVATED_ENTRY=true (then uses the larger 0.04 delta haircut).
ELEVATED_DELTA_MAX_TIGHTEN=0.02
NAKED_ELEVATED_DELTA_MAX_TIGHTEN=0.04
NAKED_ALLOW_ELEVATED_ENTRY=false
ENABLE_DYNAMIC_MIN_NET_APR=true
NAKED_DYNAMIC_MIN_NET_APR_ALLOW_LOOSEN=false

# Consecutive down days → elevated → halt (not a tighten-and-sell path).
NAKED_ENTRY_DOWN_STREAK_DAYS=2
NAKED_ENTRY_DOWN_DAY_PCT=0.015

# Income exits (same across tiers; defense thresholds stay in the tier files).
# DTE≤4 flatten is time_flatten (defense taker), not income GTC — min capture 0
# so a losing short can still be bought back.
ENABLE_EARLY_EXIT=true
TP_CAPTURE_PCT=0.55
EARLY_EXIT_REMAINING_APR=0.04
EARLY_EXIT_MIN_PROFIT_CAPTURE=0.4
EARLY_EXIT_MAX_SPREAD_RATIO=0.08
TIME_EXIT_DTE=4
TIME_EXIT_MIN_PROFIT_CAPTURE=0
ENABLE_DYNAMIC_TP=true
TP_CAPTURE_PCT_DTE_LONG=0.50
TP_CAPTURE_PCT_DTE_SHORT=0.60
TP_DTE_LONG_THRESHOLD=14
TP_DTE_SHORT_THRESHOLD=7
