# Strategy skeleton: OPTION_STRATEGY=naked_short
# Risk tiers: config/shared/strategies/tiers/naked_short/.env.{low,medium,high}
# Shared pacing & liquidity defaults: config/shared/.env.defaults

OPTION_STRATEGY=naked_short
OPTION_MARKETS_PROFILE=linear_usdc
TRADED_COLLATERALS=USDC
SHORT_OPTION_SIDE=put

# Vol gate: looser than shared defaults — naked put quality is delta + MIN_NET_APR.
# Keep a light IVR floor so dead-flat vol still skips; disable IV−RV filter.
ENABLE_IV_ENTRY_GATE=true
MIN_IV_RANK=0.05
BTC_MIN_IV_RANK=0.05
ETH_MIN_IV_RANK=0.05
MIN_IV_MINUS_RV=0

# Put-only: trend/skew side selection has no competing call wing.
ENABLE_TREND_SIDE_BIAS=false
ENABLE_SKEW_SIDE_SELECTION=false

# Wick filter: require two manage cycles before soft/hard defense.
DEFENSE_CONFIRM_CYCLES=2

# Consecutive down days → elevated (scanner already skips non-normal).
# Catches a grind that never prints a single 24h dump past INDEX_DRAWDOWN_ELEVATED.
NAKED_ENTRY_DOWN_STREAK_DAYS=2
NAKED_ENTRY_DOWN_DAY_PCT=0.015

# Income exits (same across tiers; defense thresholds stay in the tier files).
TP_CAPTURE_PCT=0.5
EARLY_EXIT_REMAINING_APR=0.04
EARLY_EXIT_MIN_PROFIT_CAPTURE=0.4
EARLY_EXIT_MAX_SPREAD_RATIO=0.08
TIME_EXIT_MIN_PROFIT_CAPTURE=0.1
ENABLE_DYNAMIC_TP=true
TP_CAPTURE_PCT_DTE_LONG=0.40
TP_CAPTURE_PCT_DTE_SHORT=0.60
TP_DTE_LONG_THRESHOLD=14
TP_DTE_SHORT_THRESHOLD=7
