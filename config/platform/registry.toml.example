# Platform registry — ops metadata only (no API secrets).
# Copy to registry.toml and edit paths/domain before ./bot investor init
#
# Strategy manifests stay in config/investors/<id>/accounts.toml (not merged here).

[platform]
repo_root = "/Users/youming/Desktop/deribit-options-strategy-engine"
python_bin = "/Users/youming/miniforge3/envs/crypto/bin/python"
domain = "debopt.com"
# New investors get hostname = template with {id} replaced (override per-row if needed).
hostname_template = "{id}-portfolio.debopt.com"
tunnel_name = "debopt-jack"
next_frontend_port = 8772

# Existing investors (optional — add rows as you onboard)
[[investors]]
id = "youming"
display_name = "YouMing"
dashboard_email = ""
access_method = "email"
hostname = "youming-portfolio.debopt.com"
frontend_port = 8765
live_enabled = true
frontend_enabled = true

[[investors]]
id = "jack"
display_name = "Jack"
dashboard_email = ""
access_method = "email"
hostname = "jack-portfolio.debopt.com"
frontend_port = 8766
live_enabled = true
frontend_enabled = true

[[investors]]
id = "an"
display_name = "An"
dashboard_email = ""
access_method = "email"
hostname = "an-portfolio.debopt.com"
frontend_port = 8768
live_enabled = true
frontend_enabled = true
